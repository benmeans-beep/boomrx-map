function parseCSV(text) {
  const lines = text.trim().split('\n');
  const headers = lines[0].split(',').map(h => h.trim().replace(/^"|"$/g,'').toLowerCase());
  return lines.slice(1).map(line => {
    // Handle quoted fields properly
    const cols = [];
    let cur = '', inQ = false;
    for (let i = 0; i < line.length; i++) {
      if (line[i] === '"') { inQ = !inQ; }
      else if (line[i] === ',' && !inQ) { cols.push(cur.trim()); cur = ''; }
      else cur += line[i];
    }
    cols.push(cur.trim());
    const obj = {};
    headers.forEach((h, i) => obj[h] = (cols[i] || '').replace(/^"|"$/g, '').trim());
    return obj;
  });
}

async function fetchFormulary() {
  if (loadingPromise) return loadingPromise;
  loadingPromise = (async () => {
    showFormularyStatus('loading');
    const urls = getSheetURLs();
    let lastErr = null;

    for (const url of urls) {
      try {
        console.log('[BoomRx] Trying:', url.substring(0, 80) + '…');
        const resp = await fetch(url, { cache: 'no-store' });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const text = await resp.text();
        if (!text || text.trim().length < 10) throw new Error('Empty response');
        // Sanity check — should look like CSV
        if (text.trim()[0] === '<') throw new Error('Got HTML instead of CSV');

        const rows = parseCSV(text);
        console.log(`[BoomRx] Got ${rows.length} rows from: ${url.substring(0,60)}`);
        if (rows.length === 0) throw new Error('Zero rows parsed');

        // Reset and populate
        SKUS_LIVE = { americas:[], vios:[], emerald:[], riteaway:[], boudrx:[], prorx:[] };
        let skipped = 0, unmatched = [];

        rows.forEach(row => {
          const active = (row['active'] || '').toLowerCase().trim();
          if (active === 'false' || active === 'no' || active === '0') { skipped++; return; }
          if (active === '' && Object.keys(row).includes('active')) { skipped++; return; }

          const pharmRaw = (row['pharmacy'] || '').toLowerCase().trim();
          const pharmId = PHARM_NAME_MAP[pharmRaw];
          if (!pharmId || !SKUS_LIVE[pharmId]) {
            if (pharmRaw && !unmatched.includes(pharmRaw)) unmatched.push(pharmRaw);
            return;
          }

          const price = row['list price'] || row['listprice'] || row['price'] || '';
          const trueCost = row['true cost'] || row['truecost'] || row['cost'] || '';

          SKUS_LIVE[pharmId].push({
            name: row['product name'] || row['productname'] || row['name'] || '',
            cat:  row['category'] || '',
            form: row['form'] || '',
            strength: row['strength'] || '',
            price: price.startsWith('$') ? price : (parseFloat(price || 0) ? '$' + parseFloat(price).toFixed(2) : price),
            trueCost: trueCost,
          });
        });

        const total = Object.values(SKUS_LIVE).reduce((s,a)=>s+a.length, 0);
        console.log(`[BoomRx] Loaded ${total} active SKUs, skipped ${skipped} inactive`);
        if (unmatched.length) console.warn('[BoomRx] Unmatched pharmacy names:', unmatched);

        formularyLoaded = true;
        formularyError = null;
        showFormularyStatus('loaded', total);
        return; // success — stop trying URLs

      } catch(err) {
        console.warn('[BoomRx] URL failed:', err.message);
        lastErr = err;
      }
    }

    // All URLs failed
    formularyError = lastErr ? lastErr.message : 'All sources failed';
    formularyLoaded = false;
    showFormularyStatus('error', 0, formularyError);
    console.error('[BoomRx] All formulary sources failed. Last error:', lastErr);
  })();
  return loadingPromise;
}

function showFormularyStatus(state, count, errMsg) {
  const bar = document.getElementById('formulary-status');
  if (!bar) return;
  if (state === 'loading') {
    bar.innerHTML = `<span class="fs-dot fs-loading"></span> Loading live formulary…`;
    bar.className = 'formulary-status loading';
    bar.style.display = 'flex';
  } else if (state === 'loaded') {
    bar.innerHTML = `<span class="fs-dot fs-ok"></span> Live formulary · ${count} active SKUs · <span class="fs-refresh" onclick="refreshFormulary()">Refresh ↺</span>`;
    bar.className = 'formulary-status loaded';
    setTimeout(() => { if (bar.className.includes('loaded')) bar.style.display = 'none'; }, 4000);
  } else {
    bar.innerHTML = `<span class="fs-dot fs-err"></span> Could not load live formulary — <span class="fs-refresh" onclick="refreshFormulary()">Retry ↺</span>`;
    bar.className = 'formulary-status error';
    bar.style.display = 'flex';
  }
}

