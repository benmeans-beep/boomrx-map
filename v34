// ─── RENDER SHEET ─────────────────────────────────────────────────────────
async function renderSheet(abbr){
  if(cST!==abbr){
    clearCustomPrices();
    if(isEditing) exitEditMode();
    aPhF=new Set();
    aCF='All';
  }
  cST=abbr;
  const name=AN[abbr]||abbr;
  document.getElementById('sheet-state').textContent=name;
  document.getElementById('ai-state-name').textContent=name;
  document.getElementById('sheet-sub').textContent='Loading formulary…';
  openSheet();

  const scroll=document.getElementById('sku-scroll');

  if(false){ // placeholder — sheet is always configured via PUBLISHED_CSV
    scroll.innerHTML=`<div class="config-notice">
      <strong>📋 Connect your Google Sheet</strong><br><br>
      To load live formulary data, publish your sheet as CSV and paste the Sheet ID into this file.
    </div>`;
    document.getElementById('sheet-sub').textContent='Sheet not connected';
    return;
  }

  if(!formularyLoaded){
    scroll.innerHTML=`<div class="sheet-loading"><div class="sheet-loading-spinner"></div>Fetching live formulary…</div>`;
    await fetchFormulary();
  }

  if(formularyError){
    scroll.innerHTML=`<div class="config-notice" style="border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08);color:#fca5a5">
      ⚠ Could not load live formulary.<br><br>
      Make sure your Google Sheet is published:<br>
      <strong>File → Share → Publish to web → Sheet → CSV → Publish</strong><br><br>
      <span style="cursor:pointer;text-decoration:underline;color:#f97316" onclick="refreshFormulary()">↺ Tap to retry</span>
    </div>`;
    document.getElementById('sheet-sub').textContent='Load error — tap retry';
    return;
  }

  const cv=getCov(abbr);
  const tot=cv.reduce((s,p)=>s+getSKUs(p.id).length,0);
  document.getElementById('sheet-sub').textContent=cv.length?`${cv.length} pharmacies · ${tot} active SKUs`:'No coverage';

  // Category filter row
  const cats=['All'];
  cv.forEach(p=>getSKUs(p.id).forEach(s=>{if(!cats.includes(s.cat))cats.push(s.cat);}));
  const cb=document.getElementById('cat-bar');
  cb.innerHTML='';
  cats.forEach(c=>{
    const b=document.createElement('button');b.className='cpill'+(aCF===c?' on':'');b.textContent=c;
    b.onclick=()=>{aCF=c;renderSKUs(abbr);};cb.appendChild(b);
  });

  // Pharmacy filter row
  renderPharmBar(abbr, cv);

  renderSKUs(abbr);
}

function renderPharmBar(abbr, cv){
  const pb=document.getElementById('pharm-bar');
  pb.innerHTML='';
  if(!cv||!cv.length) return;

  // "All" pill
  const allOn=aPhF.size===0;
  const allBtn=document.createElement('button');
  allBtn.className='ppill'+(allOn?' on':'');
  allBtn.style.borderColor=allOn?'#94a3b8':'';
  allBtn.style.background=allOn?'rgba(148,163,184,0.15)':'';
  allBtn.style.color=allOn?'#e2e8f0':'';
  allBtn.textContent='All';
  allBtn.onclick=()=>{aPhF=new Set();renderPharmBar(abbr,cv);renderSKUs(abbr);};
  pb.appendChild(allBtn);

  cv.forEach(p=>{
    const on=aPhF.has(p.id);
    const btn=document.createElement('button');
    btn.className='ppill'+(on?' on':'');
    btn.style.borderColor=on?p.color:'';
    btn.style.background=on?p.color+'28':'';
    btn.style.color=on?p.color:'';

    const dot=document.createElement('span');
    dot.style.cssText=`width:7px;height:7px;border-radius:50%;background:${p.color};flex-shrink:0;display:inline-block`;
    btn.appendChild(dot);
    btn.appendChild(document.createTextNode(p.name));

    btn.onclick=()=>{
      if(aPhF.has(p.id)) aPhF.delete(p.id); else aPhF.add(p.id);
      renderPharmBar(abbr,cv);
      renderSKUs(abbr);
    };
    pb.appendChild(btn);
  });
}

function renderSKUs(abbr){
  const cv=getCov(abbr);
  // apply pharmacy filter
  const show=aPhF.size>0 ? cv.filter(p=>aPhF.has(p.id)) : cv;
  const scroll=document.getElementById('sku-scroll');
  scroll.innerHTML='';
  if(!cv.length){scroll.innerHTML='<div style="padding:24px;color:#475569;font-size:13px;text-align:center">No pharmacies licensed in this state.</div>';return;}

  show.forEach(p=>{
    let skList=getSKUs(p.id).map((s,idx)=>({...s,idx}));
    if(aCF!=='All') skList=skList.filter(s=>s.cat===aCF);
    if(!skList.length) return;

    const grp=document.createElement('div');grp.className='pharm-group';
    grp.innerHTML=`<div class="pharm-hdr"><span class="pharm-dot" style="background:${p.color}"></span><span class="pharm-name">${p.name}</span><span class="pharm-count">${skList.length}</span></div>`;

    skList.forEach(s=>{
      const cc=CC[s.cat]||['rgba(148,163,184,0.12)','#94a3b8'];
      const curPrice=getPrice(p.id,s.idx);
      const modified=hasCustom(p.id,s.idx);
      const card=document.createElement('div');
      card.className='sku-card'+(modified?' modified':'');

      const priceBlock=isEditing
        ? `<input class="price-input" type="text" value="${curPrice.replace('$','')}" 
             onchange="handlePriceChange('${p.id}',${s.idx},this.value)"
             onclick="this.select()">`
        : `<span class="sku-price${modified?' modified':''}">${curPrice}</span>
           ${modified?`<span class="sku-orig">${s.price}</span>`:''}`;

      card.innerHTML=`
        <div class="sku-name">${s.name}</div>
        <div class="sku-meta">
          <span class="sku-cat" style="background:${cc[0]};color:${cc[1]}">${s.cat}</span>
          <span class="sku-form">${s.form}</span>
          <span class="sku-strength">${s.strength}</span>
        </div>
        <div class="sku-price-row">${priceBlock}</div>`;
      grp.appendChild(card);
    });
    scroll.appendChild(grp);
  });
  scroll.scrollTop=0;
}

function handlePriceChange(pharmId,idx,val){
  val=val.trim().replace(/[^0-9.]/g,'');
  if(!val||isNaN(parseFloat(val))) return;
  const formatted='$'+parseFloat(val).toFixed(2);
  setPrice(pharmId,idx,formatted);
  // Refresh card styling without full re-render
  renderSKUs(cST);
}

// ─── EXPORT EXCEL ─────────────────────────────────────────────────────────
// Builds raw XML for a worksheet so fill colors are guaranteed in Excel/Sheets
function buildXMLSheet(headers, rows, colWidths, customRowFlags, pharmColor){
  // Shared strings approach — embed directly
  // styles: 0=normal, 1=header, 2=custom-highlight, 3=alt-row, 4=price-custom, 5=price-normal, 6=title, 7=subtitle
  const esc=v=>String(v!==undefined&&v!==null?v:'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const pc=pharmColor||'F97316';

  // Build XML rows
  let xmlRows='';
  const allRows=[headers,...rows];
  allRows.forEach((row,ri)=>{
    const isHeader=ri===0;
    const isCustom=!isHeader&&customRowFlags&&customRowFlags[ri-1];
    let xmlCells='';
    row.forEach((val,ci)=>{
      const cellRef=String.fromCharCode(65+ci)+(ri+1);
      const v=esc(val!==undefined&&val!==null?val:'');
      // Pick style index
      let si=0;
      if(isHeader) si=1;
      else if(isCustom && ci===row.length-1) si=4; // price col custom
      else if(isCustom) si=2;                        // custom highlight
      else if(ri%2===0) si=3;                        // alt row
      xmlCells+=`<c r="${cellRef}" s="${si}" t="inlineStr"><is><t>${v}</t></is></c>`;
    });
    xmlRows+=`<row r="${ri+1}">${xmlCells}</row>`;
  });

  const colXml=colWidths.map((w,i)=>`<col min="${i+1}" max="${i+1}" width="${w}" customWidth="1"/>`).join('');

  return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
           xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
<sheetData>${xmlRows}</sheetData>
<cols>${colXml}</cols>
</worksheet>`;
}

function exportExcel(){
  if(!cST){alert('Select a state first.');return;}
  const abbr=cST, name=AN[abbr]||abbr;
  const cv=getCov(abbr);
  if(!cv.length){alert('No coverage for this state.');return;}

  const date=new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});
  const hasCustomPrices=hasAnyCustom();
  const wb=XLSX.utils.book_new();

  // ── MASTER SHEET ──────────────────────────────────────────────
  const allRows=[];
  cv.forEach(p=>{
    getSKUs(p.id).forEach((s,idx)=>{
      const curP=getPrice(p.id,idx);
      const mod=hasCustom(p.id,idx);
      allRows.push({name:s.name,cat:s.cat,form:s.form,strength:s.strength,
        price:curP,origPrice:s.price,pharmacy:p.name,hex:p.hex,modified:mod});
    });
  });

  // Header rows (info, blank, column headers)
  const masterAoa=[
    [`BoomRx Formulary — ${name}`, '', '', '', '', '', '', ''],
    [`INTERNAL ONLY · CONFIDENTIAL · Generated ${date}`, '', '', '', '', '', '', ''],
    [hasCustomPrices ? '⚠  Custom pricing applied — YELLOW rows = adjusted prices' : 'Standard pricing — no custom adjustments', '', '', '', '', '', '', ''],
    ['', '', '', '', '', '', '', ''],
    ['#', 'Product Name', 'Category', 'Form', 'Strength / Size', 'Unit Price', 'Orig Price', 'Pharmacy'],
    ...allRows.map((r,i)=>[
      i+1, r.name, r.cat, r.form, r.strength, r.price,
      r.modified ? r.origPrice : '', r.pharmacy
    ]),
  ];

  const wsM = XLSX.utils.aoa_to_sheet(masterAoa);
  wsM['!cols']=[{wch:5},{wch:44},{wch:16},{wch:14},{wch:26},{wch:12},{wch:12},{wch:18}];
  wsM['!freeze']={xSplit:0,ySplit:5};

  // Apply styles using SheetJS s property — fill IS written when cellStyles:true
  // Style header rows
  for(let c=0;c<8;c++){
    const refs=['A1','A2','A3','A4'].map((_,r)=>XLSX.utils.encode_cell({r,c}));
    // title
    if(wsM[XLSX.utils.encode_cell({r:0,c})])
      wsM[XLSX.utils.encode_cell({r:0,c})].s={font:{bold:true,sz:c===0?14:9,color:{rgb:'F97316'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'1A1A2E'}},alignment:{wrapText:false}};
    if(wsM[XLSX.utils.encode_cell({r:1,c})])
      wsM[XLSX.utils.encode_cell({r:1,c})].s={font:{italic:true,sz:9,color:{rgb:'888888'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'1A1A2E'}}};
    if(wsM[XLSX.utils.encode_cell({r:2,c})])
      wsM[XLSX.utils.encode_cell({r:2,c})].s={font:{bold:hasCustomPrices,sz:9,color:{rgb:hasCustomPrices?'FFD700':'888888'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:hasCustomPrices?'2D2500':'1A1A2E'}}};
  }
  // column header row (row index 4)
  for(let c=0;c<8;c++){
    const ref=XLSX.utils.encode_cell({r:4,c});
    if(wsM[ref]) wsM[ref].s={font:{bold:true,sz:10,color:{rgb:'FFFFFF'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'111827'}},border:{bottom:{style:'medium',color:{rgb:'F97316'}}},alignment:{horizontal:'left',vertical:'center'}};
  }
  // Data rows
  const mrng=XLSX.utils.decode_range(wsM['!ref']||'A1');
  for(let r=5;r<=mrng.e.r;r++){
    const row=allRows[r-5];
    const isMod=row&&row.modified;
    const altBg=r%2===0?'0D1117':'111827';
    // Yellow highlight for modified rows — bright so it works in light-mode Excel too
    const rowBg=isMod?'FFF9C4':altBg; // bright yellow on modified
    for(let c=0;c<=7;c++){
      const ref=XLSX.utils.encode_cell({r,c});
      if(!wsM[ref]) continue;
      let fontColor='CCCCCC',bold=false,fontSize=9;
      if(c===0){fontColor=isMod?'333333':'666666';}
      if(c===1){fontColor=isMod?'000000':'FFFFFF';bold=true;}
      if(c===2){fontColor=isMod?'333333':'94A3B8';}
      if(c===3||c===4){fontColor=isMod?'333333':'94A3B8';}
      if(c===5){fontColor=isMod?'B45309':'F97316';bold=true;fontSize=10;} // price — amber when custom
      if(c===6&&isMod){fontColor='888888';} // orig price — dimmed strikethrough effect
      if(c===7){const ph=cv.find(p=>p.name===row.pharmacy);fontColor=ph?ph.hex:'94A3B8';bold=true;}
      wsM[ref].s={
        font:{name:'Calibri',sz:fontSize,color:{rgb:isMod&&[0,1,2,3,4,5,6,7].includes(c)?fontColor:fontColor},bold},
        fill:{patternType:'solid',fgColor:{rgb:rowBg}},
        alignment:{horizontal:c===5||c===6?'right':'left',vertical:'center'},
        ...(isMod&&c===0?{border:{left:{style:'thick',color:{rgb:'F59E0B'}}}}:{})
      };
    }
  }
  XLSX.utils.book_append_sheet(wb, wsM, 'All SKUs — Master List');

  // ── PER-PHARMACY SHEETS ───────────────────────────────────────
  cv.forEach(p=>{
    const skus=getSKUs(p.id);
    const pharmAoa=[
      [`${p.name} — ${name} Formulary`,'','','',''],
      [`BoomRx · Internal Only · Generated ${date}`,'','','',''],
      ['','','','',''],
      ['#','Product Name','Category','Form · Strength','Unit Price'],
      ...skus.map((s,idx)=>[
        idx+1, s.name, s.cat,
        `${s.form} · ${s.strength}`,
        getPrice(p.id,idx)
      ]),
    ];

    const ws=XLSX.utils.aoa_to_sheet(pharmAoa);
    ws['!cols']=[{wch:5},{wch:46},{wch:16},{wch:32},{wch:14}];
    ws['!freeze']={xSplit:0,ySplit:4};

    // Title
    for(let c=0;c<5;c++){
      if(ws[XLSX.utils.encode_cell({r:0,c})])
        ws[XLSX.utils.encode_cell({r:0,c})].s={font:{bold:c===0,sz:c===0?13:9,color:{rgb:p.hex},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'111827'}}};
      if(ws[XLSX.utils.encode_cell({r:1,c})])
        ws[XLSX.utils.encode_cell({r:1,c})].s={font:{italic:true,sz:9,color:{rgb:'666666'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'111827'}}};
    }
    // Column headers (row 3)
    for(let c=0;c<5;c++){
      const ref=XLSX.utils.encode_cell({r:3,c});
      if(ws[ref]) ws[ref].s={font:{bold:true,sz:10,color:{rgb:'FFFFFF'},name:'Calibri'},fill:{patternType:'solid',fgColor:{rgb:'111827'}},border:{bottom:{style:'medium',color:{rgb:p.hex}}},alignment:{horizontal:c===4?'right':'left'}};
    }
    // Data rows
    const rng=XLSX.utils.decode_range(ws['!ref']||'A1');
    for(let r=4;r<=rng.e.r;r++){
      const idx=r-4;
      const isMod=hasCustom(p.id,idx);
      const altBg=r%2===0?'0D1117':'111827';
      const rowBg=isMod?'FFF9C4':altBg; // bright yellow
      for(let c=0;c<=4;c++){
        const ref=XLSX.utils.encode_cell({r,c});
        if(!ws[ref]) continue;
        let fontColor='CCCCCC',bold=false,fontSize=9;
        if(c===0)fontColor=isMod?'333333':'666666';
        if(c===1){fontColor=isMod?'000000':'FFFFFF';bold=true;}
        if(c===2)fontColor=isMod?'555555':'94A3B8';
        if(c===3)fontColor=isMod?'555555':'94A3B8';
        if(c===4){fontColor=isMod?'B45309':'F97316';bold=true;fontSize=10;}
        ws[ref].s={
          font:{name:'Calibri',sz:fontSize,color:{rgb:fontColor},bold},
          fill:{patternType:'solid',fgColor:{rgb:rowBg}},
          alignment:{horizontal:c===4?'right':'left',vertical:'center'},
          ...(isMod&&c===0?{border:{left:{style:'thick',color:{rgb:'F59E0B'}}}}:{})
        };
      }
    }
    XLSX.utils.book_append_sheet(wb, ws, p.name.substring(0,31));
  });

  XLSX.writeFile(wb, `BoomRx_${name.replace(/\s+/g,'_')}_Formulary.xlsx`, {bookType:'xlsx', type:'binary', cellStyles:true});

  // ★ REVERT: clear custom prices after export so next lookup is fresh
  clearCustomPrices();
  exitEditMode();
}

