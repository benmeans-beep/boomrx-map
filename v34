function flashState(abbr){
  const node=mapG.selectAll('.sp').filter(function(){return this.dataset.abbr===abbr;}).node();
  if(!node) return;
  const b=node.getBBox();
  const cx=b.x+b.width/2, cy=b.y+b.height/2;
  const k=Math.min(12,Math.max(2,Math.min(975*0.45/b.width,610*0.45/b.height)));
  const tx=975/2-k*cx, ty=610/2-k*cy;
  svg.transition().duration(600).call(zoom.transform,d3.zoomIdentity.translate(tx,ty).scale(k));
  const sel=d3.select(node);
  sel.attr('stroke','#f97316').attr('stroke-width',3/k);
  setTimeout(()=>sel.attr('stroke','#080c14').attr('stroke-width',0.8/k),1400);
}

