let customPrices={};

function getCov(abbr){return aPF?PH.filter(p=>p.id===aPF&&COV[p.id].has(abbr)):PH.filter(p=>COV[p.id].has(abbr));}
function getPrice(pharmId, idx){var _cp=customPrices[pharmId+'_'+idx]; var _sk=getSKUs(pharmId)[idx]; return _cp!==undefined?_cp:(_sk&&_sk.price?_sk.price:'');}
function setPrice(pharmId, idx, val){customPrices[pharmId+'_'+idx]=val;}
function hasCustom(pharmId, idx){var _sk2=getSKUs(pharmId)[idx]; var _sp=_sk2?_sk2.price:''; return customPrices[pharmId+'_'+idx]!==undefined && customPrices[pharmId+'_'+idx]!==_sp;}
function hasAnyCustom(){return Object.keys(customPrices).length>0;}
function clearCustomPrices(){customPrices={};}

// ─── MAP SETUP ────────────────────────────────────────────────────────────
const legEl=document.getElementById('leg-multi');
if(legEl){const w=100/PH.length;legEl.style.background=`linear-gradient(90deg,${PH.map((p,i)=>`${p.color} ${i*w}%,${p.color} ${(i+1)*w}%`).join(',')})`;}

function setPF(id){
  aPF=id;
  document.querySelectorAll('.pill').forEach(b=>b.classList.remove('active'));
  document.getElementById(id?'pf-'+id:'pf-all').classList.add('active');
  if(typeof updateMapFills==='function') updateMapFills(); else { buildPatterns(); mapG.selectAll('.sp').attr('fill',function(){const a=this.dataset&&this.dataset.abbr;return a?getFill(a):'#1c2333';}); }
  if(cST) renderSheet(cST);
}
function getFill(abbr){
  if(aPF) return COV[aPF].has(abbr)?PH.find(p=>p.id===aPF).color:'#1c2333';
  const cv=PH.filter(p=>COV[p.id].has(abbr));
  if(!cv.length) return '#1c2333';
  if(cv.length===1) return cv[0].color;
  return 'url(#s-'+abbr+')';
}
function buildPatterns(){
  svg.select('defs').selectAll('pattern').remove();
  if(aPF) return;
  Object.values(FIPS).forEach(abbr=>{
    const cv=PH.filter(p=>COV[p.id].has(abbr));
    if(cv.length<2) return;
    const n=cv.length,sw=8,total=n*sw;
    const pat=svg.select('defs').append('pattern').attr('id','s-'+abbr).attr('patternUnits','userSpaceOnUse').attr('width',total).attr('height',total).attr('patternTransform','rotate(45)');
    cv.forEach((p,i)=>{pat.append('rect').attr('x',i*sw).attr('y',0).attr('width',sw).attr('height',total).attr('fill',p.color);});
  });
}

