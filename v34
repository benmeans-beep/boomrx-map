// Try loading real TopoJSON (accurate shapes), fall back to embedded polygons
const TOPO_URLS = [
  'https://cdn.jsdelivr.net/npm/us-atlas@3/states-albers-10m.json',
  'https://unpkg.com/us-atlas@3/states-albers-10m.json',
];

async function tryLoadTopo(){
  for(const url of TOPO_URLS){
    try{
      const r=await fetch(url,{cache:'force-cache'});
      if(!r.ok) throw new Error('HTTP '+r.status);
      const data=await r.json();
      console.log('[BoomRx] TopoJSON loaded from',url);
      return data;
    }catch(e){console.warn('[BoomRx] Topo failed:',url,e.message);}
  }
  return null;
}

function renderFromEmbedded(){
  console.log('[BoomRx] Using embedded state paths');
  buildPatterns();
  Object.entries(US_STATE_PATHS).forEach(([fips, pathD])=>{
    const abbr=FIPS[fips.padStart(2,'0')]; if(!abbr) return;
    addStateEvents(
      mapG.append('path').attr('class','sp').attr('d',pathD)
        .attr('fill',getFill(abbr)).attr('stroke','#080c14').attr('stroke-width',0.8)
        .attr('data-abbr',abbr).style('cursor','pointer'),
      abbr
    );
  });
  addLabelsFromTable();
  hideSpinner();
}

function renderFromTopo(us){
  console.log('[BoomRx] Rendering from TopoJSON');
  const pg = d3.geoPath(); // pre-projected
  const feats = topojson.feature(us, us.objects.states).features;
  buildPatterns();
  feats.forEach(d=>{
    const abbr=FIPS[String(d.id).padStart(2,'0')]; if(!abbr) return;
    addStateEvents(
      mapG.append('path').attr('class','sp').attr('d',pg(d))
        .attr('fill',getFill(abbr)).attr('stroke','#080c14').attr('stroke-width',0.8)
        .attr('data-abbr',abbr).style('cursor','pointer'),
      abbr
    );
  });
  // Labels from actual centroids
  feats.forEach(d=>{
    const abbr=FIPS[String(d.id).padStart(2,'0')]; if(!abbr) return;
    let cx,cy;
    if(LABEL_OV[abbr]){[cx,cy]=LABEL_OV[abbr];}
    else{
      const c=pg.centroid(d);
      if(!c||isNaN(c[0])) return;
      [cx,cy]=c;
    }
    const b=pg.bounds(d);
    const bw=b[1][0]-b[0][0], bh=b[1][1]-b[0][1];
    if(!LABEL_OV[abbr]&&bw<18) return;
    const fs=Math.max(6,Math.min(9,Math.min(bw,bh)*0.28));
    mapG.append('text').attr('class','slabel')
      .attr('x',cx).attr('y',cy).attr('text-anchor','middle').attr('dominant-baseline','middle')
      .attr('font-size',fs+'px').attr('font-family','Inter,system-ui,sans-serif').attr('font-weight','700')
      .attr('fill','rgba(255,255,255,0.92)').attr('pointer-events','none').attr('data-fs',fs).text(abbr);
  });
  hideSpinner();
}

