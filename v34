<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>BoomRx Formulary Map</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Mono:wght@400;500&display=swap');
:root{
  --bg:#0b0f1a;--surface:#111827;--surface2:#1c2333;--surface3:#243044;
  --border:rgba(255,255,255,0.08);--border2:rgba(255,255,255,0.14);
  --text:#ffffff;--text2:#94a3b8;--text3:#475569;
  --orange:#f97316;--orange-dim:rgba(249,115,22,0.15);--orange-glow:rgba(249,115,22,0.08);
  --green:#22c55e;--green-dim:rgba(34,197,94,0.15);
  --purple:#a78bfa;--purple-dim:rgba(167,139,250,0.15);
  --sheet-radius:20px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px}

/* HEADER */
.hdr{height:52px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 16px;flex-shrink:0;z-index:10}
.logo{display:flex;align-items:center;gap:8px}
.logo-mark{width:28px;height:28px;background:var(--orange);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff}
.logo-text{font-size:15px;font-weight:700;letter-spacing:-0.3px}.logo-text span{color:var(--orange)}
.conf-badge{font-size:8px;font-family:'Inter Mono',monospace;color:var(--text3);border:1px solid rgba(249,115,22,0.25);padding:2px 7px;border-radius:3px;display:none}

/* LAYOUT */
.app{display:flex;flex-direction:column;height:100vh}
.body{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative}

/* PILL BAR */
.pill-bar{padding:9px 12px 7px;display:flex;gap:6px;overflow-x:auto;flex-shrink:0;scrollbar-width:none;background:var(--surface);border-bottom:1px solid var(--border)}
.pill-bar::-webkit-scrollbar{display:none}
.pill{display:flex;align-items:center;gap:5px;padding:5px 11px;border-radius:20px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-family:'Inter',sans-serif;font-size:12px;font-weight:500;cursor:pointer;white-space:nowrap;flex-shrink:0;transition:all .15s}
.pill.active{color:#fff;border-color:var(--orange);background:var(--orange-dim)}
.pill-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* FORMULARY STATUS BAR */
.formulary-status{padding:5px 14px;font-size:11px;font-family:'Inter Mono',monospace;display:flex;align-items:center;gap:7px;flex-shrink:0;border-bottom:1px solid var(--border);transition:all .3s}
.formulary-status.loading{background:rgba(167,139,250,0.08);color:#a78bfa}
.formulary-status.loaded{background:rgba(34,197,94,0.08);color:#34d399}
.formulary-status.error{background:rgba(239,68,68,0.08);color:#f87171}
.fs-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.fs-loading{background:#a78bfa;animation:pulse 1.2s infinite}
.fs-ok{background:#34d399}
.fs-err{background:#ef4444}
.fs-refresh{cursor:pointer;text-decoration:underline;opacity:0.8}
.fs-refresh:hover{opacity:1}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* SHEET LOADING OVERLAY */
.sheet-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:10px;color:var(--text3);font-size:12px;font-family:'Inter Mono',monospace}
.sheet-loading-spinner{width:24px;height:24px;border:2px solid var(--border2);border-top-color:var(--orange);border-radius:50%;animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* SHEET NOT CONFIGURED */
.config-notice{margin:16px;padding:14px;background:rgba(249,115,22,0.08);border:1px solid rgba(249,115,22,0.2);border-radius:10px;font-size:12px;color:#fdba74;line-height:1.7}
.config-notice code{background:rgba(255,255,255,0.08);padding:1px 5px;border-radius:3px;font-family:'Inter Mono',monospace;font-size:11px}

/* PRODUCT SEARCH IN HEADER */
.hdr{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;flex-wrap:wrap}
.prod-search-wrap{flex:1;min-width:180px;position:relative;max-width:420px}
.prod-search-input{width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:9px;padding:6px 28px 6px 28px;color:var(--text);font-family:'Inter',sans-serif;font-size:12px;outline:none;-webkit-appearance:none;transition:border-color .15s}
.prod-search-input:focus{border-color:var(--orange)}
.prod-search-input::placeholder{color:var(--text3)}
.prod-search-icon{position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--text3);pointer-events:none}
.prod-search-clear{position:absolute;right:7px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text3);font-size:12px;cursor:pointer;padding:2px 4px}

/* PRODUCT RESULTS PANEL */
.prod-panel{position:fixed;inset:0;z-index:120;display:flex;flex-direction:column;background:var(--bg)}
.prod-panel-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.prod-panel-title{font-size:15px;font-weight:700;color:var(--text)}
.prod-panel-body{flex:1;overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:8px}
.prod-state-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.prod-state-hdr{padding:10px 13px;background:var(--surface2);font-size:12px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:8px;cursor:pointer}
.prod-state-hdr:hover{background:var(--surface3)}
.prod-pharm-row{padding:8px 13px;border-top:1px solid var(--border);display:flex;align-items:center;gap:8px;font-size:12px}
.prod-pharm-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.prod-pharm-name{color:var(--text2);flex:1}
.prod-pharm-price{color:var(--text);font-weight:600;font-family:'Inter Mono',monospace}
.prod-pharm-form{color:var(--text3);font-size:11px}
.prod-no-results{text-align:center;color:var(--text3);font-size:13px;padding:40px 20px}

/* PRESCRIBER SUMMARY BUTTON */
.btn-summary{background:rgba(56,189,248,0.1);border-color:rgba(56,189,248,0.3);color:#38bdf8}
.btn-summary:hover{background:rgba(56,189,248,0.2)}

/* SUMMARY MODAL */
.summary-modal{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.7);padding:20px}
.summary-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:100%;max-width:520px;max-height:80vh;display:flex;flex-direction:column}
.summary-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.summary-head-title{font-size:14px;font-weight:700;color:var(--text)}
.summary-body{padding:16px;overflow-y:auto;flex:1}
.summary-text{background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:14px;font-size:12px;font-family:'Inter Mono',monospace;color:var(--text2);white-space:pre-wrap;line-height:1.6;user-select:all}
.summary-copy-btn{margin-top:12px;width:100%;padding:10px;background:var(--orange);border:none;border-radius:10px;color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif}
.summary-copy-btn:active{opacity:0.8}
.map-toolbar{display:flex;align-items:center;gap:8px;padding:7px 10px 0;flex-shrink:0}
.search-wrap{flex:1;position:relative}
.search-input{width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:9px;padding:7px 30px 7px 30px;color:var(--text);font-family:'Inter',sans-serif;font-size:13px;outline:none;-webkit-appearance:none;transition:border-color .15s}
.search-input:focus{border-color:var(--orange)}
.search-input::placeholder{color:var(--text3)}
.search-icon{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:15px;color:var(--text3);pointer-events:none;line-height:1}
.search-clear{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text3);font-size:13px;cursor:pointer;padding:2px 4px;line-height:1}
.search-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--surface2);border:1px solid var(--border2);border-radius:10px;z-index:50;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.4);display:none}
.search-dropdown.open{display:block}
.search-result{padding:9px 13px;font-size:13px;color:var(--text2);cursor:pointer;display:flex;align-items:center;gap:8px;transition:background .1s}
.search-result:hover,.search-result.focused{background:var(--surface3);color:var(--text)}
.search-result-abbr{font-size:10px;font-family:'Inter Mono',monospace;color:var(--text3);background:var(--surface);border:1px solid var(--border2);padding:1px 5px;border-radius:3px;flex-shrink:0}
.search-result-pharms{font-size:10px;color:var(--text3);margin-left:auto;flex-shrink:0}

/* ZOOM CONTROLS */
.zoom-controls{display:flex;flex-direction:column;gap:3px;flex-shrink:0}
.zoom-btn{width:28px;height:28px;background:var(--surface2);border:1px solid var(--border2);border-radius:7px;color:var(--text2);font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .12s;font-weight:600;line-height:1}
.zoom-btn:active,.zoom-btn:hover{background:var(--surface3);color:var(--text);border-color:var(--orange)}
.zoom-reset{font-size:12px}
@media(min-width:768px){.zoom-controls{flex-direction:row}.zoom-btn{width:30px;height:30px}}

/* MAP — allow pointer events on zoom */
.map-wrap{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative}
.hint{text-align:center;font-size:10px;color:var(--text3);padding:3px 0 2px;font-family:'Inter Mono',monospace;letter-spacing:0.3px;flex-shrink:0}
#msw{flex:1;position:relative;overflow:hidden;padding:2px 8px 8px}
#msw svg{width:100%;height:100%;touch-action:none;display:block}
.sp{transition:fill .15s}

/* LEGEND */
.legend-mini{position:absolute;bottom:10px;left:10px;background:rgba(11,15,26,0.92);border:1px solid var(--border2);border-radius:10px;padding:7px 10px;display:flex;flex-direction:column;gap:3px;z-index:5;backdrop-filter:blur(8px)}
.leg-row{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--text2)}
.leg-swatch{width:16px;height:8px;border-radius:2px;flex-shrink:0}

/* OVERLAY + SHEET */
.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:40;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(2px)}
.sheet-overlay.open{opacity:1;pointer-events:all}
.bottom-sheet{position:fixed;bottom:0;left:0;right:0;z-index:50;background:var(--surface);border-radius:var(--sheet-radius) var(--sheet-radius) 0 0;border-top:1px solid var(--border2);transform:translateY(100%);transition:transform .35s cubic-bezier(.32,.72,0,1);max-height:92vh;display:flex;flex-direction:column;overflow:visible}
.bottom-sheet.open{transform:translateY(0)}
.sheet-handle{width:36px;height:4px;background:var(--border2);border-radius:2px;margin:10px auto 0;flex-shrink:0}

/* SHEET HEAD */
.sheet-head{padding:10px 14px 8px;border-bottom:1px solid var(--border);flex-shrink:0;overflow:visible}
.sheet-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px}
.sheet-state{font-size:17px;font-weight:700;letter-spacing:-0.4px}
.sheet-sub{font-size:10px;color:var(--text3);font-family:'Inter Mono',monospace;margin-top:2px}
.btn-close{width:28px;height:28px;border-radius:50%;background:var(--surface2);border:1px solid var(--border2);color:var(--text2);font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .12s}
.btn-close:active{background:var(--surface3)}
.action-row{display:flex;gap:8px}
.btn-action{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;padding:8px;border-radius:8px;font-family:'Inter',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid}
.btn-xl{border-color:var(--orange);background:var(--orange-dim);color:var(--orange)}
.btn-xl:active{background:rgba(249,115,22,0.3)}
.btn-customize{border-color:var(--green);background:var(--green-dim);color:var(--green)}
.btn-customize:active{background:rgba(34,197,94,0.28)}
.btn-customize.editing{border-color:#ef4444;background:rgba(239,68,68,0.15);color:#ef4444}
.btn-ai{border-color:var(--purple);background:var(--purple-dim);color:var(--purple);flex:0 0 auto;padding:8px 12px}
.btn-ai:active{background:rgba(167,139,250,0.28)}

/* CATEGORY BAR */
.cat-bar{padding:7px 12px 5px;border-bottom:none;display:flex;gap:5px;overflow-x:auto;flex-shrink:0;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.cat-bar::-webkit-scrollbar{display:none}
.cat-bar .cpill{flex-shrink:0}
.pharm-bar{padding:4px 12px 7px;border-bottom:1px solid var(--border);display:flex;gap:5px;overflow-x:auto;flex-shrink:0;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.pharm-bar::-webkit-scrollbar{display:none}
.pharm-bar .ppill{flex-shrink:0}
.pharm-bar::-webkit-scrollbar{display:none}
.ppill{display:inline-flex;align-items:center;gap:5px;padding:3px 10px 3px 7px;border-radius:20px;border:1.5px solid var(--border2);background:transparent;color:var(--text3);font-size:11px;font-family:'Inter',sans-serif;font-weight:500;cursor:pointer;white-space:nowrap;transition:all .15s;flex-shrink:0}
.ppill:hover{color:var(--text2);border-color:var(--text3)}
.ppill.on{font-weight:700;color:#fff}
.cat-bar::-webkit-scrollbar{display:none}
.cpill{font-size:11px;padding:3px 9px;border-radius:20px;border:1px solid var(--border2);background:transparent;color:var(--text2);cursor:pointer;font-family:'Inter',sans-serif;white-space:nowrap;flex-shrink:0;transition:all .12s}
.cpill.on{background:var(--orange-dim);color:var(--orange);border-color:var(--orange);font-weight:500}

/* EDIT MODE NOTICE */
.edit-banner{background:rgba(34,197,94,0.1);border-bottom:1px solid rgba(34,197,94,0.25);padding:6px 14px;font-size:11px;color:#86efac;display:none;flex-shrink:0;gap:6px;align-items:center}
.edit-banner.show{display:flex}

/* SKU LIST */
.sku-scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.pharm-group{border-bottom:1px solid var(--border)}
.pharm-hdr{padding:7px 14px;display:flex;align-items:center;gap:7px;background:rgba(255,255,255,0.02);position:sticky;top:0;z-index:2;border-bottom:1px solid var(--border)}
.pharm-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.pharm-name{font-size:11px;font-weight:600}
.pharm-count{margin-left:auto;font-size:9px;font-family:'Inter Mono',monospace;color:var(--text3);background:var(--surface2);padding:1px 6px;border-radius:3px}

.sku-card{padding:9px 14px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:5px}
.sku-card.modified{background:rgba(34,197,94,0.05);border-left:2px solid var(--green)}
.sku-name{font-size:12px;font-weight:600;color:var(--text);line-height:1.4}
.sku-meta{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.sku-cat{font-size:9px;padding:2px 5px;border-radius:4px;font-weight:600}
.sku-form{font-size:10px;color:var(--text3)}
.sku-strength{font-size:10px;color:var(--text2)}
.sku-price-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.sku-price{font-size:13px;font-weight:700;color:var(--orange);font-family:'Inter Mono',monospace}
.sku-price.modified{color:var(--green)}
.sku-orig{font-size:10px;color:var(--text3);font-family:'Inter Mono',monospace;text-decoration:line-through}
.price-input{font-size:13px;font-weight:700;color:var(--green);font-family:'Inter Mono',monospace;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.4);border-radius:6px;padding:3px 8px;width:90px;text-align:right;outline:none;-webkit-appearance:none}
.price-input:focus{border-color:var(--green);background:rgba(34,197,94,0.15)}

/* AI CHAT PANEL */
.ai-panel{position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;background:var(--bg);transform:translateY(100%);transition:transform .3s cubic-bezier(.32,.72,0,1)}
.ai-panel.open{transform:translateY(0)}
.ai-head{height:52px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 16px;flex-shrink:0}
.ai-title{display:flex;align-items:center;gap:8px;font-weight:600;font-size:14px}
.ai-badge{font-size:9px;padding:2px 7px;border-radius:20px;background:var(--purple-dim);color:var(--purple);border:1px solid rgba(167,139,250,0.3);font-family:'Inter Mono',monospace;letter-spacing:0.3px}
.ai-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;-webkit-overflow-scrolling:touch}
.msg{max-width:88%;display:flex;flex-direction:column;gap:4px}
.msg.user{align-self:flex-end;align-items:flex-end}
.msg.ai{align-self:flex-start;align-items:flex-start}
.msg-bubble{padding:10px 13px;border-radius:14px;font-size:13px;line-height:1.5}
.msg.user .msg-bubble{background:var(--orange-dim);border:1px solid rgba(249,115,22,0.3);color:var(--text);border-bottom-right-radius:4px}
.msg.ai .msg-bubble{background:var(--surface2);border:1px solid var(--border2);color:var(--text);border-bottom-left-radius:4px}
.msg-bubble.loading{color:var(--text3);font-style:italic}
.ai-footer{padding:12px 14px;border-top:1px solid var(--border);background:var(--surface);flex-shrink:0;display:flex;gap:8px;align-items:flex-end}
.ai-input{flex:1;background:var(--surface2);border:1px solid var(--border2);border-radius:12px;padding:10px 13px;color:var(--text);font-family:'Inter',sans-serif;font-size:13px;outline:none;resize:none;min-height:42px;max-height:120px;line-height:1.5;-webkit-appearance:none}
.ai-input:focus{border-color:var(--purple)}
.ai-send{width:40px;height:40px;border-radius:10px;background:var(--purple-dim);border:1px solid rgba(167,139,250,0.4);color:var(--purple);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
.ai-send:active{background:rgba(167,139,250,0.3)}
.suggestion-chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.suggestion-chips::-webkit-scrollbar{display:none}
.chip{padding:5px 11px;border-radius:20px;border:1px solid rgba(167,139,250,0.3);background:var(--purple-dim);color:var(--purple);font-size:11px;cursor:pointer;white-space:nowrap;font-family:'Inter',sans-serif;transition:all .12s}
.chip:active{background:rgba(167,139,250,0.3)}
.apply-btn{display:inline-flex;align-items:center;gap:5px;margin-top:8px;padding:7px 13px;border-radius:8px;background:var(--green-dim);border:1px solid rgba(34,197,94,0.4);color:var(--green);font-size:12px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif}

/* DESKTOP */
@media(min-width:768px){
  .conf-badge{display:block}
  .bottom-sheet{position:fixed;top:0;right:0;bottom:0;left:auto;width:440px;max-height:100vh;border-radius:0;border-left:1px solid var(--border2);border-top:none;transform:translateX(100%)}
  .bottom-sheet.open{transform:translateX(0)}
  .sheet-overlay{display:none}
  .sheet-handle{display:none}
  .body{flex-direction:row}
  .map-wrap{flex:1}
  .ai-panel{left:auto;right:0;width:440px;border-left:1px solid var(--border2)}
}
</style>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob: *; connect-src *; img-src * data: blob:;">
</head>
<body>
<div class="app">
<div class="hdr">
  <div class="logo"><div class="logo-mark">Rx</div><div class="logo-text">Boom<span>Rx</span></div></div>
  <div class="prod-search-wrap">
    <span class="prod-search-icon">⌕</span>
    <input id="prod-search" class="prod-search-input" type="text" placeholder="Search products across all states…" autocomplete="off" oninput="onProdSearch(this.value)" onkeydown="onProdSearchKey(event)">
    <button class="prod-search-clear" id="prod-search-clear" onclick="clearProdSearch()" style="display:none">✕</button>
  </div>
  <div class="conf-badge">INTERNAL ONLY</div>
</div>

<!-- PRODUCT SEARCH RESULTS PANEL -->
<div class="prod-panel" id="prod-panel" style="display:none">
