// Build a license context string for the AI
function buildLicenseContext(stateAbbr){
  const stateName = AN[stateAbbr]||stateAbbr;
  const src = licenseSheetLoaded ? 'live from Google Sheet' : 'built-in data';
  const lines = [`LICENSE DATA FOR ${stateName} (${stateAbbr}) — ${src}`,''];
  PH.forEach(p=>{
    const entry = LICENSE_DB[p.id]&&LICENSE_DB[p.id][stateAbbr];
    if(entry){
      // entry is now an array of license objects
      const lics = Array.isArray(entry) ? entry : [entry];
      lines.push(`${p.name}: LICENSED`);
      lics.forEach(lic=>{
        const num  = lic.num  || 'Not yet entered';
        const exp  = lic.exp  || 'Not yet entered';
        const type = lic.type || '503A';
        lines.push(`  License #: ${num} (${type}) — Expires: ${exp}${expiryWarning(exp)}`);
        if(lic.notes) lines.push(`  Notes: ${lic.notes}`);
      });
    } else {
      lines.push(`${p.name}: NOT LICENSED in ${stateAbbr}`);
    }
    lines.push('');
  });
  return lines.join('\n');
}

function parseExpiry(str){
  if(!str) return null;
  // Handle M/D/YY, M/D/YYYY, YYYY-MM-DD
  const s = str.trim();
  if(!s) return null;
  const d = new Date(s);
  if(!isNaN(d)) return d;
  // Try M/D/YY
  const parts = s.split('/');
  if(parts.length===3){
    let [m,d2,y]=parts;
    if(y.length===2) y='20'+y;
    return new Date(`${y}-${m.padStart(2,'0')}-${d2.padStart(2,'0')}`);
  }
  return null;
}

function expiryWarning(expStr){
  const d = parseExpiry(expStr);
  if(!d) return '';
  const days = Math.ceil((d-new Date())/(1000*60*60*24));
  if(days < 0)  return ' ⚠ EXPIRED';
  if(days < 60) return ` ⚠ EXPIRES SOON (${days} days)`;
  return '';
}
function isLicenseQuery(prompt){
  const kw = ['licens','permit','number','expir','type','503','certif','board','DEA',
               'register','auth','approv','allowed','ship','active','status','credential'];
  const lower = prompt.toLowerCase();
  return kw.some(k=>lower.includes(k));
}

async function sendAI(){
  const input=document.getElementById('ai-input');
  const prompt=input.value.trim();
  if(!prompt) return;
  if(!ANTHROPIC_KEY || ANTHROPIC_KEY==='YOUR_ANTHROPIC_KEY_HERE'){
    addMsg('ai','⚠ No API key set. Open the HTML file, find ANTHROPIC_KEY near the top, and paste your key from console.anthropic.com.');
    return;
  }

  input.value='';
  addMsg('user',prompt);

  const stateName=AN[cST]||cST;
  const licenseMode = isLicenseQuery(prompt);

  const loadId=addMsg('ai', licenseMode ? 'Looking up license info…' : 'Calculating new prices…', true);

  const licenseContext = buildLicenseContext(cST);
  const skuSummary = buildSKUSummary();

  const systemPrompt = licenseMode
  ? `You are a pharmacy licensing assistant for BoomRx reps. You have access to license data for all 5 BoomRx partner pharmacies.

When asked about licenses, provide clear, direct answers. If a license number shows "TBD — not yet entered", say it's on file but the number hasn't been entered into the system yet and they should contact their BoomRx account manager.

Format your response cleanly — use the pharmacy name as a header, then license details. Be concise. If asked which pharmacies are licensed in a state, list them clearly. If asked for a specific pharmacy's license, give just that one.

Never make up license numbers. If data shows TBD, say TBD.`

  : `You are a pharmacy pricing assistant for BoomRx. Apply pricing rules to the formulary.

Return ONLY a JSON array of changes: [{"pharmId":"...","idx":number,"newPrice":"$XX.XX"}]
pharmId values: americas, vios, emerald, riteaway, boudrx
- Strip $, calculate, round to 2 decimals, minimum $0.01
- Percentage off: price*(1-pct/100)
- Flat off: price-amount
- Only include SKUs where price changes
- Return [] if no matches
Return ONLY valid JSON, no markdown, no explanation.`;

  const userMsg = licenseMode
    ? `${licenseContext}\n\nRep question: ${prompt}`
    : `State: ${stateName}\nRule: ${prompt}\n\nSKUs:\n${skuSummary}`;

  try{
    // API key for internal BoomRx tool — reps only, not public
    const resp=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'x-api-key': ANTHROPIC_KEY,
        'anthropic-version':'2023-06-01',
        'anthropic-dangerous-direct-browser-access':'true'
      },
      body:JSON.stringify({
        model:'claude-sonnet-4-5',
        max_tokens:1000,
        system:systemPrompt,
        messages:[{role:'user',content:userMsg}]
      })
    });
    const data=await resp.json();
    const raw=(data.content&&data.content[0]&&data.content[0].text)||'';
    removeMsg(loadId);

    if(licenseMode){
      // Plain text response — display directly
      addMsg('ai', raw);
      return;
    }

    // Pricing mode — parse JSON
    let changes;
    try{
      const cleaned=raw.replace(/```json?/g,'').replace(/```/g,'').trim();
      changes=JSON.parse(cleaned);
    }catch(e){
      addMsg('ai','Sorry, I had trouble parsing that. Try rephrasing — e.g. "10% off peptides" or "$5 off weight loss".');
      return;
    }

    if(!Array.isArray(changes)||changes.length===0){
      addMsg('ai',`No SKUs matched that rule for ${stateName}.`);
      return;
    }

    changes.forEach(c=>{
      if(c.pharmId&&c.idx!==undefined&&c.newPrice) setPrice(c.pharmId,c.idx,c.newPrice);
    });

    const catCounts={};
    changes.forEach(c=>{
      const s=(getSKUs(c.pharmId)||[])[c.idx];
      if(s) catCounts[s.cat]=(catCounts[s.cat]||0)+1;
    });
    const summary=Object.entries(catCounts).map(([k,v])=>`${v} ${k}`).join(', ');

    if(!isEditing) enterEditMode();
    else renderSKUs(cST);

    const msgEl=addMsg('ai',`✓ Applied to ${changes.length} SKUs (${summary}).\n\nPrices shown in green — export when ready. Prices revert after export.`);
    const btnRow=document.createElement('div');btnRow.style.cssText='display:flex;gap:8px;margin-top:8px';
    const revertBtn=document.createElement('button');
    revertBtn.className='apply-btn';
    revertBtn.style.cssText='background:rgba(239,68,68,0.15);border-color:rgba(239,68,68,0.4);color:#ef4444';
    revertBtn.innerHTML='↩ Revert prices';
    revertBtn.onclick=()=>{exitEditMode();closeAI();};
    btnRow.appendChild(revertBtn);
    msgEl.querySelector('.msg-bubble').appendChild(btnRow);

  }catch(err){
    removeMsg(loadId);
    addMsg('ai','Network error — check your connection and try again.');
  }
}

let msgCounter=0;
function addMsg(role,text,loading=false){
  const id='msg-'+(++msgCounter);
  const msgs=document.getElementById('ai-messages');
  const div=document.createElement('div');div.className=`msg ${role}`;div.id=id;
  const bubble=document.createElement('div');bubble.className='msg-bubble'+(loading?' loading':'');
