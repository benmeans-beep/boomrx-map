function runProdSearch(query){
  const q = query.toLowerCase();
  const panel = document.getElementById('prod-panel');
  const body  = document.getElementById('prod-panel-body');
  const title = document.getElementById('prod-panel-title');

  // Find all matching SKUs across all pharmacies/states
  // Group by product name first, then show states
  const byProduct = {};

  PH.forEach(p=>{
    getSKUs(p.id).forEach((sku, idx)=>{
      if(!sku.name.toLowerCase().includes(q) && !sku.cat.toLowerCase().includes(q)) return;
      const key = sku.name + '||' + sku.form + '||' + sku.strength;
      if(!byProduct[key]) byProduct[key] = {sku, pharmEntries:[]};

      // Find all states this pharmacy+sku combo is available in
      Object.keys(AN).forEach(abbr=>{
        if(!COV[p.id].has(abbr)) return;
        byProduct[key].pharmEntries.push({
          abbr, stateName:AN[abbr],
          pharmId:p.id, pharmName:p.name, pharmColor:p.color,
          price: getPrice(p.id, idx), idx
        });
      });
    });
  });

  const products = Object.values(byProduct);
  const totalStates = new Set(products.flatMap(p=>p.pharmEntries.map(e=>e.abbr))).size;

  title.textContent = products.length
    ? `"${query}" — ${products.length} product${products.length!==1?'s':''} across ${totalStates} states`
    : `No results for "${query}"`;

  body.innerHTML = '';
  panel.style.display = 'flex';

  if(!products.length){
    body.innerHTML = `<div class="prod-no-results">No products matching "<strong>${query}</strong>" found.</div>`;
    return;
  }

  products.forEach(({sku, pharmEntries})=>{
    const card = document.createElement('div');
    card.className = 'prod-state-card';
    const cc = CC[sku.cat]||['rgba(148,163,184,0.12)','#94a3b8'];

    // Header — product name
    const hdr = document.createElement('div');
    hdr.className = 'prod-state-hdr';
    hdr.style.cursor = 'default';
    hdr.innerHTML = `
      <span style="font-size:11px;background:${cc[0]};color:${cc[1]};padding:2px 7px;border-radius:4px">${sku.cat}</span>
      <span style="font-weight:700;color:var(--text)">${sku.name}</span>
      <span style="color:var(--text3);font-size:11px;margin-left:4px">${sku.form} ${sku.strength}</span>
      <span style="margin-left:auto;color:var(--text3);font-size:10px">${new Set(pharmEntries.map(e=>e.abbr)).size} states</span>`;
    card.appendChild(hdr);

    // Group entries by pharmacy
    const byPharm = {};
    pharmEntries.forEach(e=>{
      if(!byPharm[e.pharmId]) byPharm[e.pharmId]={name:e.pharmName,color:e.pharmColor,price:e.price,states:[]};
      byPharm[e.pharmId].states.push(e.abbr);
    });

    Object.values(byPharm).forEach(({name,color,price,states})=>{
      const row = document.createElement('div');
      row.className = 'prod-pharm-row';
      // Show first 8 states then +N more
      const shown = states.slice(0,10).join(', ');
      const extra = states.length > 10 ? ` +${states.length-10} more` : '';
      row.innerHTML = `
        <span class="prod-pharm-dot" style="background:${color}"></span>
        <div style="flex:1;min-width:0">
          <div style="font-size:12px;color:var(--text2);font-weight:600">${name}</div>
          <div style="font-size:10px;color:var(--text3);margin-top:2px">${shown}${extra}</div>
        </div>
        <span class="prod-pharm-price">${price}</span>`;
      card.appendChild(row);
    });

    body.appendChild(card);
  });
}

